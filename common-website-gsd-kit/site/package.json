    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@gltf-transform/cli": "4.4.2",
    "@pmndrs/detect-gpu": "6.0.18",
    "@types/three": "0.185.0",
    "gltfpack": "1.2.0",
    "typescript": "5.9.3"
  }
}
