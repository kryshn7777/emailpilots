{
  "$comment": "PROPOSED Claude Code config for Email Pilots. NOT ACTIVE. Review, then apply by renaming to settings.json (or merge into an existing one). Applying it (a) hard-blocks reads of secret/state files, (b) adds a Stop hook that type-checks changed TS, (c) versions a scoped allow-list. Machine-specific / one-off allows should stay in settings.local.json. See .claude/README.md.",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Edit(.env)",
      "Write(.env)",
      "Read(accounts.json)",
      "Edit(accounts.json)",
      "Write(accounts.json)",
      "Read(limits.json)",
      "Read(limits.*.json)",
      "Edit(limits.*.json)",
      "Write(limits.*.json)",
      "Read(suppression.json)",
      "Read(replies.json)",
      "Read(imap.json)",
      "Read(imap.*.json)",
      "Read(stats.json)",
      "Read(scheduler.json)",
      "Read(campaigns.json)",
      "Read(sequences.json)",
      "Read(recipients.json)",
      "Read(recipients.csv)",
      "Read(EmailPiolets 2/**)",
      "Edit(EmailPiolets 2/**)",
      "Write(EmailPiolets 2/**)",
      "Edit(website/**)",
      "Write(website/**)"
    ],
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:watch)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm ci)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx vite *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh repo view*)",
      "Bash(gh auth status)",
      "PowerShell(npx tsc *)",
      "PowerShell(npm test*)",
      "PowerShell(npx vitest *)",
      "PowerShell(npx vite *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git add *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/typecheck-on-stop.ps1",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
