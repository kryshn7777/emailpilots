node_modules/
release/
dist/
build/
*.rar
*.zip
*.exe
.playwright-mcp/
website/.playwright-mcp/
*.log

# Secrets & per-user runtime data — never commit (contains credentials / recipient PII / send state)
.env
recipients.json
recipients.csv
accounts.json
limits.json
limits.*.json
stats.json
suppression.json
scheduler.json
# Reply analytics + drip sequence state (recipient PII / runtime cursors)
replies.json
imap.json
imap.*.json
campaigns.json
sequences.json
# Idempotency send-ledger (audit A3): per-recipient delivered-content hashes (recipient PII).
# Glob covers sent-ledger.json, sent-ledger.<id>.json AND sent-ledger-owner.json (the
# ownership cursor) + .corrupt sidecars — the old sent-ledger.*.json pattern missed the
# -owner variant (no dot after "sent-ledger"). Mirrors the sent-log* convention below.
sent-ledger*
# Send history behind the Sent screen (recipient emails + subjects = PII), incl. .corrupt sidecars
sent-log*

# Brainstorming visual-companion scratch (mockups, server state)
.superpowers/

# Landing preview screenshots (scratch — regenerated by landing/shot.mjs)
landing/preview-*.png

# Claude Code typecheck Stop-hook stamp (local timing marker)
.claude/hooks/.typecheck-stamp

# Knowledge-graph output (regenerated by /gsd:graphify — AST cache, ~180 files)
graphify-out/
.planning/graphs/

# Scratch: one-off pricing comparison shots, pasted issue images, Windows shortcuts
app-pricing.png
landing-pricing.png
pricing_screenshot_landing.png
Issues/
*.lnk
