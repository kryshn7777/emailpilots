# SMTP Credentials
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# Your email address
SMTP_USER=your-email@outlook.com
# Use an App Password if 2FA is enabled
SMTP_PASS=your-app-password

# Paths (relative to the data dir / next to the .exe)
RECIPIENTS_CSV_PATH=recipients.csv
RECIPIENTS_JSON_PATH=recipients.json
TEMPLATE_HTML_PATH=template.html

# Email Subject
EMAIL_SUBJECT="Daily Update"

# Schedule (Cron format: minute hour day-of-month month day-of-week)
# Default: 09:00 every day
CRON_SCHEDULE="0 9 * * *"

# Safe Defaults for v1 (rate limits). Omit any key to use the default shown.
# Hard ceiling on emails sent per calendar day.
MAX_EMAILS_PER_DAY=50
# Max emails per sending window (burst bucket).
MAX_EMAILS_PER_WINDOW=10
# Max windows per day (5 x 10 = 50).
MAX_WINDOWS_PER_DAY=5
# Random pacing delay BETWEEN consecutive batch sends, in minutes.
MIN_DELAY_MIN=1
MAX_DELAY_MIN=10
# Max total attachment size per email, in MB.
MAX_ATTACHMENT_MB=10
# Max sends to the same recipient per day (1 initial + 2 follow-ups).
MAX_RECIPIENT_PER_DAY=3

# Deliverability / anti-ban (Phase 1 rails)
# Gradually ramp the daily cap for new accounts (true/false).
WARMUP_ENABLED=true
# Day-indexed daily caps during warmup, then settles at MAX_EMAILS_PER_DAY.
WARMUP_CURVE="5,5,10,10,15,20,25,30,40,50"
# Physical postal address appended to every email footer (CAN-SPAM requirement).
PHYSICAL_ADDRESS=""
# Add unsubscribe link + List-Unsubscribe header (true/false).
UNSUBSCRIBE_ENABLED=true
# Inbox placement: "primary" = look like 1:1 mail (drops List-Unsubscribe,
# CAN-SPAM footer, and <head>/<style>) so it lands in Gmail's Primary tab.
# "bulk" = keep those markers for cold/bulk sending. Default: primary.
INBOX_PLACEMENT="primary"

# Practice mode: deliver every email (batch AND scheduled) to the sending
# account's own inbox instead of the real recipient. Subject is prefixed with
# the intended address. Rate limits still apply. Default: false.
TEST_MODE=false
